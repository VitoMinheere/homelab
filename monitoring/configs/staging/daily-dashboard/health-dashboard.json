    {
      "id": 9,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "daily-dashboard-pg"
      },
      "type": "table",
      "title": "Reasons",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "daily-dashboard-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT day AS \"Day\",\n       overall_status AS \"Overall\",\n       reasons AS \"Reasons\",\n       sleep_hours AS \"Sleep (h)\",\n       body_battery_at_wake AS \"Body battery at wake\",\n       resting_hr AS \"Resting HR\",\n       resting_hr_baseline AS \"RHR baseline\",\n       stress_high_pct AS \"High stress %\",\n       training_done AS \"Training done\",\n       steps AS \"Steps\",\n       weight_avg_kg AS \"Weight 7d (kg)\"\nFROM dashboard.health_daily\nWHERE day BETWEEN $__timeFrom()::timestamptz::date AND $__timeTo()::timestamptz::date\nORDER BY day DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
