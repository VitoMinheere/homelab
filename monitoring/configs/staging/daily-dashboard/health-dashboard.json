          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (day::timestamp AT TIME ZONE 'Europe/Amsterdam') AS time,\n       dashboard.status_level(overall_status)    AS \"Overall\",\n       dashboard.status_level(sleep_status)      AS \"Sleep\",\n       dashboard.status_level(body_battery_status) AS \"Body battery\",\n       dashboard.status_level(resting_hr_status) AS \"Resting HR\",\n       dashboard.status_level(stress_status)     AS \"Stress\",\n       dashboard.status_level(training_status)   AS \"Training\"\nFROM dashboard.health_daily\nWHERE day BETWEEN $__timeFrom()::timestamptz::date AND $__timeTo()::timestamptz::date\nORDER BY day"
